# ============================================
# FAIX Chatbot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# Django Security Settings (REQUIRED)
# ============================================

# Generate a strong secret key using:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here-change-in-production

# Comma-separated list of allowed hosts
# For development: localhost,127.0.0.1
# For production: your-domain.com,www.your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# CORS Settings (REQUIRED)
# ============================================

# Comma-separated list of allowed origins for CORS
# For development: http://localhost:3000,http://localhost:8000
# For production: https://your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================
# Database Configuration (Optional)
# ============================================

# Default: SQLite (no configuration needed)
# For PostgreSQL, uncomment and configure:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=faix_chatbot
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your-password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ============================================
# LLM Configuration (Optional)
# ============================================

# Enable/disable LLM features (true/false)
LLM_ENABLED=true

# Ollama base URL
LLM_BASE_URL=http://localhost:11434

# Model name (must be available in Ollama)
LLM_MODEL=llama3.2:latest

# Request timeout in seconds
LLM_TIMEOUT=20

# ============================================
# NLP Configuration (Optional)
# ============================================

# Intent classification confidence threshold (0.0-1.0)
NLP_CONFIDENCE_THRESHOLD=0.3

# Use zero-shot classification (true/false)
NLP_USE_ZERO_SHOT=true

# ============================================
# Cache Configuration (Optional)
# ============================================

# Cache backend: 'django.core.cache.backends.locmem.LocMemCache' or 'redis'
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Redis configuration (if using Redis)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# Cache timeouts (in seconds)
CACHE_TIMEOUT_STATIC=86400    # 24 hours for static data
CACHE_TIMEOUT_DYNAMIC=1800    # 30 minutes for dynamic data

# ============================================
# Rate Limiting (Optional)
# ============================================

# Maximum requests per window
RATE_LIMIT_REQUESTS=30

# Time window in seconds
RATE_LIMIT_WINDOW=60

# ============================================
# Security Settings (Optional)
# ============================================

# Debug mode (NEVER set to true in production!)
DEBUG=false

# Enable HTTPS redirect (production only)
# SECURE_SSL_REDIRECT=true

# Session cookie settings
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# ============================================
# Logging Configuration (Optional)
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
# LOG_FILE=/var/log/faix_chatbot.log

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable speech recognition
ENABLE_SPEECH=true

# Enable demo mode
ENABLE_DEMO=true

# Enable feedback system
ENABLE_FEEDBACK=true

# ============================================
# File Uploads (Optional)
# ============================================

# Maximum file upload size in MB
MAX_UPLOAD_SIZE=10

# Media root directory
# MEDIA_ROOT=/path/to/media

# Static files directory
# STATIC_ROOT=/path/to/static

# ============================================
# Email Configuration (Optional)
# ============================================

# For sending notifications (if needed)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# Monitoring & Analytics (Optional)
# ============================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://your-sentry-dsn

# Google Analytics ID
# GA_ID=UA-XXXXXXXX-X

# ============================================
# Development Settings (Optional)
# ============================================

# Auto-reload on code changes (development only)
# AUTORELOAD=true

# Enable Django debug toolbar
# ENABLE_DEBUG_TOOLBAR=false
